# ----- Backend Raíces Duranguenses · PRODUCCIÓN (CloudPanel) -----
# Copia este archivo como .env en el servidor y rellena los valores reales.
# NO lo subas al repositorio con datos reales.

PORT=4000
NODE_ENV=production

# Base de datos MySQL que crees en CloudPanel (Databases).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=raices_prod
DB_PASSWORD=__PON_UNA_CONTRASEÑA_FUERTE__
DB_NAME=raices_prod

# Secreto para firmar los tokens. Genera uno nuevo y largo, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__GENERA_UN_SECRETO_LARGO_Y_ALEATORIO__
JWT_EXPIRES=8h

# Dominio EXACTO del frontend (con https). Sin barra final.
# Ej.: https://sistema.raicesduranguenses.com
CORS_ORIGIN=https://__TU_DOMINIO_DEL_FRONTEND__

# El ETL del sistema viejo (OLD_DB_*) NO se usa en producción: la migración de
# clientes va por `npm run seed:clientes-mig` (datos ya fijos en el código).
